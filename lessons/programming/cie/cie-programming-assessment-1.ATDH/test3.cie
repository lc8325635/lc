DECLARE Total : INTEGER
DECLARE Count : INTEGER

// FOR loops

Total <- 0
FOR Count <- 1 TO 10
    Total <- Total + Count
NEXT Count

ASSERT Total = 55

// Reverse FOR loops

Total <- 0
FOR Count <- 10 TO 1 STEP -1
    Total <- Total + Count
NEXT Count

ASSERT Total = 55

// REPEAT loops

Total <- 0
Count <- 0
REPEAT 
    Total <- Total + Count
    Count <- Count + 1
UNTIL Count = 10

ASSERT Total = 45

// WHILE loops

Total <- 0
Count <- 0
WHILE Count <= 10 DO
    Total <- Total + Count
    Count <- Count + 1
ENDWHILE

ASSERT Total = 55

OUTPUT "All tests passed!"
